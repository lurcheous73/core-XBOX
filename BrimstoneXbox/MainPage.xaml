<Page x:Class="BrimstoneXbox.MainPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="{StaticResource BrimstoneBackground}" KeyDown="Page_KeyDown">
 <Page.Resources>
  <DataTemplate x:Key="CoverTemplate">
   <Border Width="230" Height="300" Background="{StaticResource BrimstonePanel}" CornerRadius="16" Margin="7">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="190"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Background="#27193A">
      <TextBlock Text="♫" FontSize="68" Foreground="{StaticResource BrimstoneAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <Image Source="{Binding Artwork}" Stretch="UniformToFill"/>
     </Grid>
     <StackPanel Grid.Row="1" Margin="14,10">
      <TextBlock Text="{Binding Artist}" Foreground="{StaticResource BrimstoneAccent}" FontSize="16" TextTrimming="CharacterEllipsis"/>
      <TextBlock Text="{Binding Title}" FontSize="21" FontWeight="SemiBold" MaxLines="2" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Meta}" FontSize="14" Foreground="{StaticResource BrimstoneMuted}" TextTrimming="CharacterEllipsis"/>
     </StackPanel>
    </Grid>
   </Border>
  </DataTemplate>
 </Page.Resources>
 <Viewbox Stretch="Uniform">
  <!-- Shared iOS visual language, with a 1600x900 safe-area canvas for 1080p/4K TVs. -->
  <Grid Width="1600" Height="900" Margin="0" Background="{StaticResource BrimstoneBackground}">
   <Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition Height="*"/><RowDefinition Height="75"/></Grid.RowDefinitions>
   <Grid Margin="52,18,52,10">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Image Source="Assets/Brand.png" Width="62" Height="62" Margin="0,0,18,0"/>
     <StackPanel><TextBlock Text="Brimstone Xbox Control" FontSize="32" FontWeight="SemiBold"/>
      <TextBlock x:Name="ConnectionText" Text="R1 revision 29 · Connect to your Core" Foreground="{StaticResource BrimstoneMuted}" FontSize="17"/>
     </StackPanel>
    </StackPanel>
    <ComboBox x:Name="OutputPicker" Grid.Column="1" Width="330" VerticalAlignment="Center" PlaceholderText="Choose speaker" DisplayMemberPath="Content" SelectionChanged="Output_Changed"/>
   </Grid>
   <Grid x:Name="Shell" Grid.Row="1" Margin="48,0,48,10" Visibility="Collapsed">
    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel>
     <Button Content="Home" Tag="Home" Click="Navigate_Click" HorizontalAlignment="Stretch"/>
     <Button Content="Playing" Tag="Playing" Click="Navigate_Click" HorizontalAlignment="Stretch"/>
     <Button Content="Your Music" Tag="Your Music" Click="Navigate_Click" HorizontalAlignment="Stretch"/>
     <Button Content="Streaming" Tag="Streaming" Click="Navigate_Click" HorizontalAlignment="Stretch"/>
     <Button Content="Spoken Word" Tag="Spoken Word" Click="Navigate_Click" HorizontalAlignment="Stretch"/>
     <Button Content="Videos" Tag="Videos" Click="Navigate_Click" HorizontalAlignment="Stretch"/>
     <Button Content="Settings" Tag="Settings" Click="Navigate_Click" HorizontalAlignment="Stretch"/>
     <TextBlock Text="R1 revision 29&#xA;Control · 2.5.0" Foreground="{StaticResource BrimstoneMuted}" Margin="16,28,0,0" FontSize="15"/>
    </StackPanel>
    <Grid Grid.Column="2">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="Heading" Text="Home" FontSize="36" FontWeight="SemiBold" Margin="4,4,0,12"/>
      <Button Grid.Column="1" Content="Refresh" Click="Refresh_Click"/>
     </Grid>
     <StackPanel x:Name="Filters" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
      <ComboBox x:Name="CollectionPicker" Width="230" SelectedIndex="0" SelectionChanged="Filter_Changed">
       <ComboBoxItem Content="Albums" Tag="albums"/><ComboBoxItem Content="Bootlegs" Tag="bootlegs"/>
       <ComboBoxItem Content="Mixtapes" Tag="mixtapes"/><ComboBoxItem Content="Concerts" Tag="concerts"/>
       <ComboBoxItem Content="Radio recordings" Tag="radio_recordings"/>
      </ComboBox>
      <ComboBox x:Name="SpokenPicker" Width="230" SelectedIndex="0" SelectionChanged="Filter_Changed" Visibility="Collapsed">
       <ComboBoxItem Content="Podcasts"/><ComboBoxItem Content="Audiobooks"/>
      </ComboBox>
      <ComboBox x:Name="BandPicker" Width="260" SelectionChanged="Filter_Changed" Visibility="Collapsed"/>
      <TextBox x:Name="SearchBox" Width="430" PlaceholderText="Search artist or title" TextChanged="Search_Changed" Margin="16,0,0,0"/>
     </StackPanel>
     <Grid Grid.Row="2">
      <GridView x:Name="Cards" ItemTemplate="{StaticResource CoverTemplate}" IsItemClickEnabled="True" ItemClick="Card_Click"
       SelectionMode="Single" IsTabStop="True" XYFocusKeyboardNavigation="Enabled"/>
      <TextBlock x:Name="EmptyText" Visibility="Collapsed" Foreground="{StaticResource BrimstoneMuted}" FontSize="22" TextWrapping="Wrap" Margin="12,30"/>
      <Grid x:Name="PlayingPanel" Visibility="Collapsed">
       <Grid.ColumnDefinitions><ColumnDefinition Width="0.7*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Background="{StaticResource BrimstonePanel}" CornerRadius="18" Padding="24">
        <StackPanel>
         <Image x:Name="PlayingArtwork" Height="235" Stretch="Uniform"/>
         <TextBlock x:Name="PlayingTitle" Text="Nothing playing" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" Margin="0,16,0,8"/>
         <TextBlock x:Name="PlayingArtist" FontSize="19" Foreground="{StaticResource BrimstoneMuted}" TextWrapping="Wrap" MaxLines="2"/>
         <TextBlock x:Name="PlayingState" FontSize="16" Foreground="{StaticResource BrimstoneAccent}" Margin="0,12"/>
         <Slider x:Name="Seek" Minimum="0" Maximum="1" ValueChanged="Seek_Changed"/>
         <TextBlock x:Name="TimeText" FontSize="16" Foreground="{StaticResource BrimstoneMuted}"/>
         <StackPanel Orientation="Horizontal" Margin="0,12,0,4">
          <Button Content="Previous" Tag="previous" Click="Transport_Click"/><Button x:Name="PlayButton" Content="Play" Tag="resume" Click="Transport_Click"/>
          <Button Content="Next" Tag="next" Click="Transport_Click"/>
         </StackPanel>
         <StackPanel Orientation="Horizontal"><Button Content="Stop" Tag="stop" Click="Transport_Click"/>
          <Button Content="Mute" Click="Mute_Click"/><Slider x:Name="Volume" Width="220" Minimum="0" Maximum="100" Value="70" ValueChanged="Volume_Changed"/>
         </StackPanel>
        </StackPanel>
       </Border>
       <Border Grid.Column="2" Background="{StaticResource BrimstonePanel}" CornerRadius="18" Padding="20">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
         <Grid><TextBlock Text="Queue" FontSize="27"/><Button Content="Clear queue" HorizontalAlignment="Right" Click="ClearQueue_Click"/></Grid>
         <ListView x:Name="QueueList" Grid.Row="1" SelectionMode="None" Margin="0,16,0,0">
          <ListView.ItemTemplate><DataTemplate><StackPanel Margin="4,10"><TextBlock Text="{Binding Title}" FontSize="21"/>
           <TextBlock Text="{Binding Meta}" Foreground="{StaticResource BrimstoneMuted}" FontSize="16"/></StackPanel></DataTemplate></ListView.ItemTemplate>
         </ListView>
        </Grid>
       </Border>
      </Grid>
      <Grid x:Name="AlbumPanel" Visibility="Collapsed">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <StackPanel Orientation="Horizontal"><Button Content="Back" Click="AlbumBack_Click"/>
        <Button Content="Play" Click="PlayAlbum_Click"/><Button Content="Add to queue" Click="AppendAlbum_Click"/>
        <ComboBox x:Name="EditionPicker" Width="350" DisplayMemberPath="Title" SelectionChanged="Edition_Changed"/>
       </StackPanel>
       <TextBlock x:Name="AlbumTitle" Grid.Row="1" FontSize="27" Margin="4,14" TextWrapping="Wrap"/>
       <ListView x:Name="Tracks" Grid.Row="2" IsItemClickEnabled="True" ItemClick="Track_Click" SelectionMode="Single">
        <ListView.ItemTemplate><DataTemplate><Grid Margin="4,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBlock Text="{Binding Title}" FontSize="22" VerticalAlignment="Center"/>
         <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Play" Tag="{Binding}" Click="TrackPlay_Click"/>
          <Button Content="Add to queue" Tag="{Binding}" Click="TrackAppend_Click"/></StackPanel>
        </Grid></DataTemplate></ListView.ItemTemplate>
       </ListView>
      </Grid>
      <Grid x:Name="VideoPanel" Visibility="Collapsed">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Button Content="Back to videos" Click="VideoBack_Click" HorizontalAlignment="Left"/>
       <MediaPlayerElement x:Name="VideoPlayer" Grid.Row="1" AreTransportControlsEnabled="True"/>
       <TextBlock x:Name="VideoMetadata" Grid.Row="2" FontSize="20" TextWrapping="Wrap" Foreground="{StaticResource BrimstoneMuted}" Margin="4,14"/>
      </Grid>
      <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed">
       <StackPanel Margin="10,12" MaxWidth="800" HorizontalAlignment="Left">
        <TextBlock Text="Connected to your existing Core" FontSize="25" FontWeight="SemiBold"/>
        <TextBlock x:Name="CoreAddressText" FontSize="21" Foreground="{StaticResource BrimstoneMuted}" Margin="0,12"/>
        <TextBlock Text="Xbox Control streams from Core. It does not host a Core engine, database, ripper or local API. Existing app data is retained." FontSize="20" TextWrapping="Wrap"/>
        <CheckBox x:Name="CompatibleVideo" IsChecked="True" Content="Compatible video delivery from Core" Margin="0,22,0,0"/>
        <TextBlock Text="Console audio follows Xbox system settings (HDMI / optical). Video and music stream without saving media files." FontSize="20" TextWrapping="Wrap" Foreground="{StaticResource BrimstoneMuted}"/>
        <Button Content="Change Core / sign out" Click="Forget_Click" HorizontalAlignment="Left" Margin="0,25"/>
       </StackPanel>
      </ScrollViewer>
     </Grid>
    </Grid>
   </Grid>
   <Grid x:Name="SetupPanel" Grid.Row="1" Margin="180,35" Visibility="Visible">
    <StackPanel MaxWidth="950" HorizontalAlignment="Center">
     <TextBlock Text="Connect to your Core" FontSize="44" FontWeight="SemiBold"/>
     <TextBlock Text="Your music lives on Core. This Xbox is your Control and player." FontSize="23" Foreground="{StaticResource BrimstoneMuted}" Margin="0,16,0,25" TextWrapping="Wrap"/>
     <TextBlock Text="Core address" FontSize="20"/><TextBox x:Name="CoreUrlBox" PlaceholderText="https://core.local:8443"/>
     <TextBlock Text="Username" FontSize="20"/><TextBox x:Name="UsernameBox" Text="admin"/>
     <TextBlock Text="Password" FontSize="20"/><PasswordBox x:Name="PasswordBox" PasswordRevealMode="Peek"/>
     <Button x:Name="ConnectButton" Content="Connect" Click="Connect_Click" HorizontalAlignment="Left" Margin="0,24,0,8"/>
     <TextBlock x:Name="SetupStatus" TextWrapping="Wrap" Foreground="{StaticResource BrimstoneMuted}" FontSize="20"/>
    </StackPanel>
   </Grid>
   <Grid Grid.Row="2" Margin="52,0,52,14">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="FooterTitle" Text="Brimstone Control · R1 revision 29" VerticalAlignment="Center" FontSize="20" TextTrimming="CharacterEllipsis"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Playing" Tag="Playing" Click="Navigate_Click"/>
     <Button Content="Play / Pause" Click="FooterPlay_Click"/>
    </StackPanel>
   </Grid>
   <Border x:Name="ToastBorder" Grid.RowSpan="3" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="200,0,200,90" Padding="22,14" Background="#EE342048" CornerRadius="12" Visibility="Collapsed">
    <TextBlock x:Name="ToastText" FontSize="21" TextWrapping="Wrap"/>
   </Border>
  </Grid>
 </Viewbox>
</Page>
