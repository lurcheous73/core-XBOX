<Page
    x:Class="BrimstoneXbox.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BrimstoneXbox"
    xmlns:models="using:BrimstoneXbox.Models"
    Background="{StaticResource BrimstoneBackground}"
    KeyDown="Page_KeyDown">

    <Grid Padding="44,30,44,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="116"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="54" Height="54" CornerRadius="13" Background="{StaticResource BrimstoneAccent}" Margin="0,0,16,0">
                    <TextBlock Text="B" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="BRIMSTONE CORE" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource BrimstoneText}"/>
                    <TextBlock Text="Xbox · Beta 1" FontSize="17" Foreground="{StaticResource BrimstoneMuted}"/>
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="2" Background="{StaticResource BrimstonePanel}" CornerRadius="12" Padding="18,10" VerticalAlignment="Center">
                <TextBlock x:Name="ConnectionText" Text="Not connected" FontSize="18" Foreground="{StaticResource BrimstoneMuted}"/>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BrimstonePanel}" CornerRadius="16" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Button x:Name="MusicNavButton" Content="Your Music" HorizontalAlignment="Stretch" Click="MusicNavButton_Click"/>
                        <Button x:Name="NowNavButton" Content="Now Playing" HorizontalAlignment="Stretch" Click="NowNavButton_Click"/>
                        <Button x:Name="RipNavButton" Content="Rip Disc" HorizontalAlignment="Stretch" Click="RipNavButton_Click"/>
                        <Button x:Name="SettingsNavButton" Content="Settings" HorizontalAlignment="Stretch" Click="SettingsNavButton_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="8,18,8,8">
                        <TextBlock Text="Controller" FontSize="14" Foreground="{StaticResource BrimstoneMuted}"/>
                        <TextBlock Text="A select · B back" FontSize="15" Foreground="{StaticResource BrimstoneMuted}" Margin="0,4,0,0"/>
                        <TextBlock Text="View Now Playing" FontSize="15" Foreground="{StaticResource BrimstoneMuted}"/>
                        <TextBlock Text="Menu Settings" FontSize="15" Foreground="{StaticResource BrimstoneMuted}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid x:Name="LoginPanel">
                    <Border Width="720" MaxWidth="720" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{StaticResource BrimstonePanel}" CornerRadius="18" Padding="42">
                        <StackPanel>
                            <TextBlock Text="Connect this Xbox to Core" FontSize="34" FontWeight="SemiBold"/>
                            <TextBlock Text="The Xbox becomes a normal Brimstone playback endpoint. Pairing uses Core's per-device trust token."
                                       FontSize="19" TextWrapping="Wrap" Foreground="{StaticResource BrimstoneMuted}" Margin="0,10,0,24"/>
                            <TextBlock Text="Core address" FontSize="16" Foreground="{StaticResource BrimstoneMuted}"/>
                            <TextBox x:Name="CoreUrlBox" PlaceholderText="http://10.26.30.20:8080" Text="http://10.26.30.20:8080"/>
                            <TextBlock Text="Username" FontSize="16" Foreground="{StaticResource BrimstoneMuted}" Margin="0,12,0,0"/>
                            <TextBox x:Name="UsernameBox" Text="admin"/>
                            <TextBlock Text="Password" FontSize="16" Foreground="{StaticResource BrimstoneMuted}" Margin="0,12,0,0"/>
                            <PasswordBox x:Name="PasswordBox" PasswordRevealMode="Peek"/>
                            <Button x:Name="ConnectButton" Content="Connect &amp; Pair Xbox" HorizontalAlignment="Left"
                                    Background="{StaticResource BrimstoneAccent}" Margin="0,24,0,0" Click="ConnectButton_Click"/>
                            <TextBlock x:Name="LoginStatusText" Margin="0,18,0,0" FontSize="18" TextWrapping="Wrap"
                                       Foreground="{StaticResource BrimstoneMuted}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="MusicPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Your Music" FontSize="38" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LibrarySummaryText" Text="Core library" FontSize="18" Foreground="{StaticResource BrimstoneMuted}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Refresh" Click="RefreshButton_Click"/>
                    </Grid>

                    <GridView x:Name="AlbumGrid" Grid.Row="1" IsItemClickEnabled="True" ItemClick="AlbumGrid_ItemClick"
                              SelectionMode="None" IsTabStop="False">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" ItemWidth="270" ItemHeight="176"/>
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:CoreAlbum">
                                <Border Width="254" Height="160" Margin="7" CornerRadius="14"
                                        Background="{StaticResource BrimstonePanel}" BorderBrush="#3C3747" BorderThickness="1">
                                    <Grid Padding="18">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="◉" FontSize="28" Foreground="{StaticResource BrimstoneAccent}"/>
                                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Title}" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind Artist}" FontSize="17" Foreground="{StaticResource BrimstoneMuted}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Row="2" Text="{x:Bind Meta}" FontSize="14" Foreground="{StaticResource BrimstoneMuted}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </Grid>

                <Grid x:Name="AlbumPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Back" Click="BackToLibraryButton_Click"/>
                        <Button x:Name="PlayAlbumButton" Content="Play album" Background="{StaticResource BrimstoneAccent}" Click="PlayAlbumButton_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="6,24,0,20">
                        <TextBlock x:Name="AlbumTitleText" FontSize="38" FontWeight="SemiBold"/>
                        <TextBlock x:Name="AlbumArtistText" FontSize="22" Foreground="{StaticResource BrimstoneMuted}"/>
                    </StackPanel>

                    <ListView x:Name="TracksList" Grid.Row="2" IsItemClickEnabled="True" ItemClick="TracksList_ItemClick" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:CoreTrack">
                                <Grid Height="64" Padding="12,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" FontSize="20" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind Artist}" FontSize="15" Foreground="{StaticResource BrimstoneMuted}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind DurationText}" VerticalAlignment="Center"
                                               FontSize="16" Foreground="{StaticResource BrimstoneMuted}" Margin="20,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Grid x:Name="NowPlayingPanel" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="820">
                        <TextBlock Text="NOW PLAYING" HorizontalAlignment="Center" FontSize="16" Foreground="{StaticResource BrimstoneAccent}"/>
                        <TextBlock x:Name="NowTitleText" Text="Nothing playing" HorizontalAlignment="Center" TextAlignment="Center"
                                   FontSize="44" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,18,0,6"/>
                        <TextBlock x:Name="NowArtistText" HorizontalAlignment="Center" FontSize="24" Foreground="{StaticResource BrimstoneMuted}"/>
                        <TextBlock x:Name="NowAlbumText" HorizontalAlignment="Center" FontSize="19" Foreground="{StaticResource BrimstoneMuted}" Margin="0,4,0,30"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="Previous" Click="PreviousButton_Click"/>
                            <Button x:Name="PlayPauseButton" Content="Pause" Background="{StaticResource BrimstoneAccent}" Click="PlayPauseButton_Click"/>
                            <Button Content="Stop" Click="StopButton_Click"/>
                            <Button Content="Next" Click="NextButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Grid x:Name="RipPanel" Visibility="Collapsed">
                    <Border Background="{StaticResource BrimstonePanel}" CornerRadius="18" Padding="40"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Width="820">
                        <StackPanel>
                            <TextBlock Text="Rip Disc" FontSize="38" FontWeight="SemiBold"/>
                            <TextBlock Text="Beta 1 uses the optical drive attached to Brimstone Core. Xbox internal UHD-drive access is a supported-API capability probe only and will be enabled only if Xbox exposes enough legal access."
                                       TextWrapping="Wrap" FontSize="21" Foreground="{StaticResource BrimstoneMuted}" Margin="0,18,0,22"/>
                            <TextBlock Text="Use iPad, macOS or Windows Control to start the Core rip for now."
                                       FontSize="22" TextWrapping="Wrap"/>
                            <Border Background="#221C30" CornerRadius="10" Padding="18" Margin="0,26,0,0">
                                <TextBlock x:Name="OpticalStatusText" Text="Xbox optical probe: capability declared · device test pending"
                                           FontSize="18" Foreground="{StaticResource BrimstoneAccent}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="SettingsPanel" Visibility="Collapsed">
                    <Border Background="{StaticResource BrimstonePanel}" CornerRadius="18" Padding="38" Width="840"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="Settings" FontSize="38" FontWeight="SemiBold"/>
                            <TextBlock Text="Core" FontSize="15" Foreground="{StaticResource BrimstoneMuted}" Margin="0,24,0,4"/>
                            <TextBlock x:Name="SettingsCoreText" FontSize="20"/>
                            <TextBlock Text="Xbox endpoint" FontSize="15" Foreground="{StaticResource BrimstoneMuted}" Margin="0,18,0,4"/>
                            <TextBlock x:Name="SettingsEndpointText" FontSize="20" TextWrapping="Wrap"/>
                            <TextBlock Text="Listener" FontSize="15" Foreground="{StaticResource BrimstoneMuted}" Margin="0,18,0,4"/>
                            <TextBlock x:Name="SettingsAddressText" FontSize="20"/>
                            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                                <Button Content="Re-pair Xbox" Click="RepairButton_Click"/>
                                <Button Content="Forget Core" Click="ForgetButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource BrimstonePanel}" CornerRadius="16" Padding="20,14" Margin="0,18,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="FooterTitleText" Text="Nothing playing" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock x:Name="FooterMetaText" Text="Xbox renderer ready" FontSize="16" Foreground="{StaticResource BrimstoneMuted}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="◀" Click="PreviousButton_Click"/>
                    <Button x:Name="FooterPlayPauseButton" Content="▶" Background="{StaticResource BrimstoneAccent}" Click="PlayPauseButton_Click"/>
                    <Button Content="■" Click="StopButton_Click"/>
                    <Button Content="▶▶" Click="NextButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="ToastBorder" Grid.RowSpan="3" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,138" Background="#E6282531" CornerRadius="10" Padding="18,12"
                Visibility="Collapsed">
            <TextBlock x:Name="ToastText" FontSize="18"/>
        </Border>
    </Grid>
</Page>
