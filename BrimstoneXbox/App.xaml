<Application
    x:Class="BrimstoneXbox.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <SolidColorBrush x:Key="BrimstoneBackground" Color="#08080B"/>
        <SolidColorBrush x:Key="BrimstonePanel" Color="#15151B"/>
        <SolidColorBrush x:Key="BrimstonePanelRaised" Color="#20202A"/>
        <SolidColorBrush x:Key="BrimstoneAccent" Color="#8F5BFF"/>
        <SolidColorBrush x:Key="BrimstoneText" Color="#F3F1F8"/>
        <SolidColorBrush x:Key="BrimstoneMuted" Color="#AAA5B5"/>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="MinWidth" Value="78"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource BrimstoneText}"/>
            <Setter Property="Background" Value="{StaticResource BrimstonePanelRaised}"/>
            <Setter Property="BorderBrush" Value="#464052"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Margin" Value="0,7"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="52"/>
            <Setter Property="Margin" Value="0,7"/>
            <Setter Property="FontSize" Value="22"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
        </Style>
    </Application.Resources>
</Application>
